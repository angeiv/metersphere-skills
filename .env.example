# MeterSphere 2.x API 配置
# 复制此文件为 .env 并填写实际值

# 必需环境变量
METERSPHERE_BASE_URL=http://your-metersphere-instance:8081
METERSPHERE_ACCESS_KEY=your_access_key_here
METERSPHERE_SECRET_KEY=your_secret_key_here

# 推荐环境变量
# METERSPHERE_WORKSPACE_ID=your_workspace_id
# METERSPHERE_PROJECT_ID=your_default_project_id
# METERSPHERE_PROTOCOL=HTTP

# 可选环境变量
# METERSPHERE_HEADERS_JSON={"X-Custom-Header":"value"}
# METERSPHERE_DEFAULT_VERSION_ID=your_version_id
# METERSPHERE_PAGE_SIZE=20

# 说明:
# 1. `workspace list` 用于查询当前账号可访问的工作空间
# 2. 默认版本 ID 优先读取 METERSPHERE_DEFAULT_VERSION_ID
# 3. 若未设置默认版本，脚本会先尝试 `/project/project/version/get-default-version/{projectId}`
# 4. 若默认版本接口不可用，脚本会从现有功能/API 用例回退解析 versionId

# 安全警告:
# 1. METERSPHERE_SECRET_KEY 仅在本地用于签名，不会传输到服务器
# 2. METERSPHERE_HEADERS_JSON 可以注入任意 HTTP 头，请谨慎使用
# 3. 使用最小权限的 API Key，避免在生产环境中使用高权限密钥
